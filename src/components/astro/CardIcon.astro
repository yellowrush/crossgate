---
export interface Props {
  type?: number;
}

const { type = 0 } = Astro.props;

let label = '普通卡';
let bg = 'var(--body-complement)';
let color = 'var(--text-muted)';
if (type === 1) {
  label = '银卡';
  bg = '#C0C0C0';
  color = '#333';
} else if (type === 2) {
  label = '金卡';
  bg = '#FFD700';
  color = '#5a3800';
}
---

<span class="card-icon" style={{ background: bg, color }}>
  {label}
</span>

<style>
  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 3px;
    vertical-align: middle;
    line-height: 1.4;
  }
</style>
