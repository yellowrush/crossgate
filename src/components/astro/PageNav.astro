---
export interface Props {
  prev?: { text: string; link: string };
  next?: { text: string; link: string };
}

const { prev, next } = Astro.props;
---

<nav class="page-nav">
  {prev && (
    <a href={prev.link} class="prev">
      <span class="hint">&larr; 上一篇</span>
      <span class="title">{prev.text}</span>
    </a>
  )}
  {next && (
    <a href={next.link} class="next">
      <span class="hint">下一篇 &rarr;</span>
      <span class="title">{next.text}</span>
    </a>
  )}
</nav>

<style>
  .page-nav {
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
    margin-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .page-nav a {
    text-decoration: none;
    color: var(--accent);
    max-width: 45%;
  }

  .hint {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .title {
    display: block;
    font-size: 0.95rem;
  }
</style>
