---
export interface Props {
  type?: 'tip' | 'warning' | 'error';
}

const { type = 'tip' } = Astro.props;

const badgeColors: Record<string, string> = {
  tip: 'var(--badge-tip)',
  warning: 'var(--badge-warning)',
  error: 'var(--badge-error)',
};
---

<span class="badge" style={`background: ${badgeColors[type]}`}>
  <slot />
</span>

<style>
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0.15em 0.5em;
    border-radius: 3px;
    font-weight: 600;
    vertical-align: middle;
  }
</style>
