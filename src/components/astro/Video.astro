---
export interface Props {
  src: string;
  width?: number;
  height?: number;
}

const { src, width = 560, height = 315 } = Astro.props;
---

<iframe
  src={src}
  width={width}
  height={height}
  frameborder="0"
  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
  allowfullscreen
></iframe>
