---
export interface Props {
  title?: string;
  image?: string;
  type?: string;
  url?: string;
  size?: 'normal' | 'small';
  new?: boolean;
}

const { title, image, type: cardType, url, size = 'normal', new: isNew } = Astro.props;
---

<a href={url || '#'} class={`card card-${size}`}>
  {image && <img src={image} alt={title || ''} class="card-image" />}
  <div class="card-body">
    {title && <h3 class="card-title">{title}</h3>}
    {cardType && <span class="card-type">{cardType}</span>}
    {isNew && <Badge type="tip">New</Badge>}
  </div>
</a>

<style>
  .card {
    display: inline-flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: box-shadow 0.2s;
  }

  .card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .card-image {
    width: 100%;
    height: auto;
  }

  .card-body {
    padding: 0.5rem;
  }

  .card-title {
    margin: 0;
    font-size: 0.95rem;
  }

  .card-type {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .card-normal {
    width: 180px;
  }

  .card-small {
    width: 120px;
  }
</style>
