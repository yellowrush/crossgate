---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Sidebar from '../components/astro/Sidebar.astro';
import Footer from '../components/astro/Footer.astro';
import Comment from '../components/vue/Comment.vue';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description, lang } = Astro.props;
interface SidebarItem {
  text: string;
  link?: string;
  children?: SidebarItem[];
}

const sidebarItems: SidebarItem[] = [
  {
    text: '🗂️ 攻略',
    children: [
      { text: '⚔️ 练级路线', link: '/leveling' },
      { text: '📜 游戏任务', link: '/tasks' },
      { text: '🅾️ Q&A', link: '/questions' },
      { text: '🦸‍♂️ 游戏账号', link: '/guides/register' },
    ],
  },
  {
    text: '💾 游戏数据',
    children: [
      { text: '🔮 宝石属性', link: '/gems' },
      { text: '🐉 宠物大全', link: '/pets' },
    ],
  },
  {
    text: '⚒️ 游戏工具',
    children: [
      { text: '🧮 宠物算档器', link: '/tools/calculate' },
      { text: '🛸 全书离线APP', link: '/guides/pwa' },
    ],
  },
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="theme-container">
    <Navbar />
    <div class="sidebar-mask" id="sidebar-mask"></div>
    <Sidebar items={sidebarItems} />
    <main class="page">
      <slot />
      <Comment client:load />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .theme-container {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .page {
    flex: 1;
    margin-left: var(--sidebar-width);
    padding-top: var(--navbar-height);
  }

  .sidebar-mask {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
    z-index: 9;
  }

  @media (max-width: 719px) {
    .page {
      margin-left: 0;
    }
  }
</style>
