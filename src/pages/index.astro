<DocLayout title="魔力全书" description="魔力玩家的百科全书">
  <main class="home">
    <section class="home-section">
      <h2>?? 最新活動</h2>
      <BannerCarousel :banners={banners} client:load />
    </section>

    <section class="home-section">
      <h2>📰 最新公告</h2>
      <NewsList :news={newsList} client:load />
    </section>

    <section class="home-section">
      <h2>🕒 服务器维护时间</h2>
      <p>每周四 10:00-12:00</p>
    </section>

    <div class="footer">
      <p>魔力全书 &copy; 2026 make with ❤️</p>
      <p>本站所有图档等资料版权 - 史克威尔艾尼克斯</p>
    </div>
  </main>
</DocLayout>

<style>
  .home {
    margin-left: var(--sidebar-width);
    padding: calc(var(--navbar-height) + 2rem) 2rem 2rem;
    max-width: var(--home-page-width);
    margin-right: auto;
  }

  .home-section {
    margin-bottom: 2rem;
  }

  .home-section h2 {
    font-size: 1.4rem;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-align: center;
  }

  .footer p {
    margin: 0.2rem 0;
  }

  @media (max-width: 719px) {
    .home {
      margin-left: 0;
    }
  }
</style>
